{
    "name": "amaia/entities13",
    "description": "Entity management for Laravel 13: CRUD, soft deletes, archive, trash and select options.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "amaia/basics13": "^1.0",
        "larastan/larastan": "^3.9",
        "laravel/dusk": "^8.7",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.3",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "entities13\\Database\\Factories\\": "database/factories/",
            "entities13\\Database\\Seeders\\": "database/seeders/",
            "entities13\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "tests/Fixtures/App/",
            "entities13\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "entities13\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../packages/basics13",
            "options": {
                "symlink": true
            }
        }
    ]
}
